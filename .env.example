# Server only. Never use VITE_* for secrets. Do not commit .env.
SKETCH_AI_ENABLED=false
SKETCH_AI_API_KEY=
SKETCH_AI_MODEL=gpt-4.1-mini-2025-04-14
# Confirm CURRENT official pricing before setting these and enabling generation.
SKETCH_AI_PRICING_REVIEWED=false
SKETCH_AI_INPUT_USD_PER_MILLION=
SKETCH_AI_OUTPUT_USD_PER_MILLION=
# Defaults: 1 concurrent call; 3/minute; 5/process; $0.25/process reserved estimate;
# 4096 output tokens; 30-second timeout; 0 automatic retries.
