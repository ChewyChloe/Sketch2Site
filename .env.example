# Server only. Never use VITE_* for secrets. Do not commit .env.
SKETCH_AI_ENABLED=false
SKETCH_AI_API_KEY=
SKETCH_AI_MODEL=gpt-6-luna
# Candidate only. Verify official ID, Responses/strict JSON support, reasoning defaults
# and project access before setting true. Flags are NOT paid-test authorization.
SKETCH_AI_MODEL_REVIEWED=false
# Confirm CURRENT official pricing before setting these and enabling generation.
SKETCH_AI_PRICING_REVIEWED=false
SKETCH_AI_INPUT_USD_PER_MILLION=
SKETCH_AI_OUTPUT_USD_PER_MILLION=
SKETCH_AI_CACHED_INPUT_USD_PER_MILLION=
# Match explicit authorization; start with ONE call. Never restart to bypass caps.
SKETCH_AI_MAX_CALLS=1
SKETCH_AI_BUDGET_USD=
# Hard ceilings: 1 concurrent call; 3/minute; 5/process; $0.25/process reserved estimate;
# 4096 output tokens; 30-second timeout; 0 automatic retries.

# Sites Worker only: runtime secrets/configuration, never VITE_*.
# Site must remain owner-private. Trusted owner email comes only from Sites owner policy.
# The dispatch-authenticated Site subject is enrolled into D1; never accept browser owner IDs.
SKETCH_SITE_ORIGIN=
SKETCH_AI_OWNER_EMAIL=
SKETCH_AI_BILLING_CONFIRMED=false
SKETCH_AI_CACHE_WRITE_USD_PER_MILLION=0.125
# Explicit approval is separate from configuration. Keep false while preparing.
SKETCH_AI_TEST_APPROVED=false
# Exact SHA-256 of the approved validated CanvasSpec; see offline preflight.
SKETCH_AI_TEST_CANVAS_SHA256=
# ISO timestamp, no more than one hour in the future at activation.
SKETCH_AI_TEST_EXPIRES_AT=
# Worker hard caps: one permanent Site-wide call, <=US$0.01 reserved estimate.
# D1 consumes the slot BEFORE any provider call; failures never refund/reset it.

# Exact free input counting is required; unknown or >8192 tokens rejects generation.
# Full generation request <=16384 UTF-8 bytes, model=gpt-6-luna, tier=default, TTL=30m, tools=[].
